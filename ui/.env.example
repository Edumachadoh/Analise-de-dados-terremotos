# Copie para .env e ajuste. Depois de mudar, reinicie o `npm run dev`.

# usgs (padrão): os dados vêm direto da API do USGS, sem precisar do back-end.
# back: usa a API REST do back (Django, pasta backend/).
VITE_FONTE=usgs

# Endereço da API do back, usado só com VITE_FONTE=back.
# O padrão /api passa pelo proxy do Vite até http://127.0.0.1:8000.
VITE_API_URL=/api
