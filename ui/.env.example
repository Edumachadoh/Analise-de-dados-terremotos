# Copie para .env e ajuste. Depois de mudar, reinicie o `npm run dev`.

# true (padrão): usa a API simulada no navegador, sem precisar do back-end.
# false: usa a API REST real (back Django em backend/).
VITE_USAR_MOCK=true

# Endereço da API real. O padrão /api passa pelo proxy do Vite até http://127.0.0.1:8000.
VITE_API_URL=/api
